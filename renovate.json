{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 0,12 * * *"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "nix": {
    "enabled": true
  },
  "pinDigests": false,
  "packageRules": [
    {
      "matchManagers": ["regex"],
      "matchFileNames": ["modules/home/fish.nix"],
      "groupName": "fish plugins"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["\\.nix$"],
      "matchStrings": [
        "fetchFromGitHub[\\s\\S]{0,500}?owner\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]{0,500}?repo\\s*=\\s*\"(?<packageName>[^\"]+)\"[\\s\\S]{0,500}?rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["\\.nix$"],
      "matchStrings": [
        "pname\\s*=\\s*\"(?<packageName>[^\"]+)\"[\\s\\S]{0,500}?version\\s*=\\s*\"(?<currentValue>[^\"]+)\"[\\s\\S]{0,500}?fetchFromGitHub[\\s\\S]{0,500}?owner\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]{0,500}?repo\\s*=\\s*pname[\\s\\S]{0,500}?rev\\s*=\\s*version"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["\\.nix$"],
      "matchStrings": [
        "pname\\s*=\\s*\"(?<packageName>[^\"]+)\"[\\s\\S]{0,500}?fetchFromGitHub[\\s\\S]{0,500}?owner\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]{0,500}?repo\\s*=\\s*pname[\\s\\S]{0,500}?rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}