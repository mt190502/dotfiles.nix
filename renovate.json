{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 0,12 * * *"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "nix": {
    "enabled": true
  },
  "pinDigests": false,
  "packageRules": [
    {
      "matchFileNames": ["modules/home/fish.nix"],
      "groupName": "fish plugins"
    },
    {
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["jorgebucaran/nvm.fish", "jorgebucaran/fisher", "szclsya/mpdris2-rs"],
      "versioning": "semver-coerced"
    },
    {
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["GhostNaN/recidia-audio-visualizer", "bouquet2/water", "mt190502/pomobar"],
      "versioning": "semver"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["modules/home/fish.nix"],
      "matchStrings": [
        "src = pkgs\\.fetchFromGitHub \\{\\s+owner = \"(?<depName>[^\"]+)\";\\s+repo = \"(?<packageName>[^\"]+)\";\\s+rev = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{depName}}}/{{{packageName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["modules/home/mpdris2-rs.nix", "packages/recidia.nix", "packages/water.nix"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "pname = \"(?<packageName>[^\"]+)\";",
        "version = \"(?<currentValue>[^\"]+)\";",
        "owner = \"(?<depName>[^\"]+)\";",
        "repo = pname;",
        "rev = version;"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{depName}}}/{{{packageName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["modules/home/pomobar.nix"],
      "matchStringsStrategy": "combination",
      "matchStrings": [
        "pname = \"(?<packageName>[^\"]+)\";",
        "owner = \"(?<depName>[^\"]+)\";",
        "repo = pname;",
        "rev = \"(?<currentValue>[^\"]+)\";"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{depName}}}/{{{packageName}}}"
    }
  ]
}