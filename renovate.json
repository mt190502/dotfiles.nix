{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 0,12 * * *"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "nix": {
    "enabled": true
  },
  "pinDigests": false,
  "packageRules": [
    {
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["jorgebucaran/nvm.fish", "jorgebucaran/fisher"],
      "groupName": "fish plugins"
    },
    {
      "matchDatasources": ["github-tags"],
      "matchPackageNames": ["szclsya/mpdris2-rs"],
      "versioning": "semver-coerced"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*.nix"],
      "matchStrings": [
        "src\\s*=\\s*pkgs\\.fetchFromGitHub\\s*\\{\\s+owner\\s*=\\s*\"(?<depName>[^\"]+)\";\\s+repo\\s*=\\s*\"(?<packageName>[^\"]+)\";\\s+rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{depName}}}/{{{packageName}}}"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["**/*.nix"],
      "matchStrings": [
        "pname\\s*=\\s*\"(?<packageName>[^\"]+)\";[\\s\\S]*?version\\s*=\\s*\"(?<currentValue>[^\"]+)\";[\\s\\S]*?src\\s*=\\s*fetchFromGitHub\\s*\\{[\\s\\S]*?owner\\s*=\\s*\"(?<depName>[^\"]+)\";[\\s\\S]*?repo\\s*=\\s*pname;[\\s\\S]*?rev\\s*=\\s*version;"
      ],
      "datasourceTemplate": "github-tags",
      "packageNameTemplate": "{{{depName}}}/{{{packageName}}}"
    }
  ]
}