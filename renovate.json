{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":semanticCommits",
    ":ignoreModulesAndTests"
  ],
  "timezone": "Europe/Istanbul",
  "schedule": ["* 0,12 * * *"],
  "prHourlyLimit": 0,
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 10,
  "rebaseWhen": "conflicted",
  "labels": ["dependencies"],
  "nix": {
    "enabled": true
  },
  "pinDigests": false,
  "packageRules": [
    {
      "matchCategories": ["fish-plugins"],
      "groupName": "fish plugins"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "fetchFromGitHub[\\s\\S]{0,300}?owner\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]{0,300}?repo\\s*=\\s*\"(?<packageName>[^\"]+)\"[\\s\\S]{0,300}?rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "categoryTemplate": "fish-plugins"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "pname\\s*=\\s*\"(?<packageName>[^\"]+)\"[\\s\\S]{0,500}?version\\s*=\\s*\"(?<currentValue>[^\"]+)\"[\\s\\S]{0,500}?fetchFromGitHub[\\s\\S]{0,300}?owner\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]{0,300}?repo\\s*=\\s*pname[\\s\\S]{0,300}?rev\\s*=\\s*version"
      ],
      "datasourceTemplate": "github-tags",
      "categoryTemplate": "nix-packages"
    },
    {
      "customType": "regex",
      "fileMatch": ["\\.nix$"],
      "matchStrings": [
        "pname\\s*=\\s*\"(?<packageName>[^\"]+)\"[\\s\\S]{0,500}?fetchFromGitHub[\\s\\S]{0,300}?owner\\s*=\\s*\"(?<depName>[^\"]+)\"[\\s\\S]{0,300}?repo\\s*=\\s*pname[\\s\\S]{0,300}?rev\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-tags",
      "categoryTemplate": "nix-packages"
    }
  ]
}